{
  "name": "vfsimport",
  "version": "1.1.0",
  "description": "High performance CSV to VFS Server batch uploader CLI using Bun",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "vfsimport": "./index.ts"
  },
  "scripts": {
    "start": "bun run index.ts",
    "test": "bun test",
    "build": "bun build --compile --minify index.ts --outfile dist/vfsimport",
    "build:linux-x64": "bun build --compile --minify --target=bun-linux-x64 index.ts --outfile dist/vfsimport-linux-x64",
    "build:linux-arm64": "bun build --compile --minify --target=bun-linux-arm64 index.ts --outfile dist/vfsimport-linux-arm64",
    "build:darwin-arm64": "bun build --compile --minify --target=bun-darwin-arm64 index.ts --outfile dist/vfsimport-darwin-arm64",
    "build:darwin-x64": "bun build --compile --minify --target=bun-darwin-x64 index.ts --outfile dist/vfsimport-darwin-x64",
    "build:windows-x64": "bun build --compile --minify --target=bun-windows-x64 index.ts --outfile dist/vfsimport-windows-x64.exe",
    "build:all": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:windows-x64"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5 || ^7"
  }
}
